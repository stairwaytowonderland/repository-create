{
	"name": "repository-create",
	"version": "1.92.0",
	"description": "Dynamically create GitHub repositories with pre-defined settings and branch rulesets using Octokit.js.",
	"type": "module",
	"private": true,
	"exports": {
		".": "./dist/index.js"
	},
	"engines": {
		"node": ">=24.0.0",
		"npm": ">=8.0.0"
	},
	"scripts": {
		"clean": "rm -rf node_modules dist",
		"clean-cache": "npm cache clean --force",
		"postinstall": "npm run package-lock:fix && printf '\\033[1;32m%s:\\033[0m\\033[0;32m %s\\033[0m\n' 'Installation complete' 'Run `npm run build` to build the project.'",
		"build": "tsc --showConfig",
		"bundle": "npm run check && npm run build && npm run package",
		"format:write": "prettier --write \"src/**/*.ts\" ./*.{json,mjs,ts,yaml}",
		"format:check": "prettier --check \"src/**/*.ts\" ./*.{json,mjs,ts,yaml}",
		"format-check": "npm run format:check",
		"format": "npm run format:write",
		"prettier": "npm run format:check",
		"lint:check": "eslint \"src/**/*.ts\"",
		"lint:fix": "eslint \"src/**/*.ts\" --fix",
		"lint": "npm run lint:check",
		"package": "rimraf ./dist && rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
		"package:watch": "npm run package -- --watch",
		"typecheck": "tsc --noEmit",
		"package-lock:install": "npm install --package-lock-only --ignore-scripts",
		"package-lock:fix": "node -e \"const fs = require('fs'); const f = 'package-lock.json'; const c = fs.readFileSync(f, 'utf8').trimEnd(); fs.writeFileSync(f, c + '\\n');\"",
		"install:clean": "npm run clean && rm -f package-lock.json && npm run package-lock:install && npm install",
		"fix": "npm run format:write && npm run lint:fix",
		"check": "npm run typecheck && npm run lint && npm run prettier",
		"test": "printf 'No tests defined\n'",
		"prep": "npm run fix && npm run bundle",
		"all": "npm run install:clean && npm run fix && npm test && npm run bundle"
	},
	"keywords": [
		"github",
		"actions"
	],
	"license": "GPL-3.0-only",
	"dependencies": {},
	"devDependencies": {
		"@actions/core": "^3.0.0",
		"@actions/github": "^9.0.0",
		"@eslint/compat": "^2.0.2",
		"@eslint/eslintrc": "^3.3.3",
		"@eslint/js": "^10.0.1",
		"@rollup/plugin-commonjs": "^29.0.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-typescript": "^12.3.0",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@types/node": "^25.9.3",
		"@typescript-eslint/eslint-plugin": "^8.61.0",
		"conventional-changelog-conventionalcommits": "^8.0.0",
		"dotenv": "^17.4.2",
		"esbuild": "^0.28.1",
		"eslint": "^10.0.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"prettier": "^3.8.4",
		"rimraf": "^6.1.3",
		"rollup": "^4.62.5",
		"rollup-plugin-license": "^3.7.1",
		"semantic-release": "^25.0.5",
		"semantic-release-export-data": "^1.2.0",
		"tslib": "^2.8.1",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3"
	},
	"optionalDependencies": {
		"@rollup/rollup-linux-x64-gnu": "*"
	},
	"resolutions": {
		"ip-address": "10.31.0"
	},
	"overrides": {
		"undici": "^6.29.1",
		"semantic-release": {
			"undici": "^7.30.1",
			"@semantic-release/github": {
				"undici": "^7.30.1"
			}
		}
	}
}
